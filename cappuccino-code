\n  (Stage 09B: 0.5944 | Stage 09C CORAL: 0.5811 | Stage 10 ep1: 0.6271)\nBest epoch       : 1\nTest set         : NOT USED | Stage 05B split: UNCHANGED\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# ================================================================\n# CAPSTONE — STAGE 10C | JOINT TRAINING, LOW LR, TIGHT EARLY STOP\n#\n# Findings so far:\n#   Stage 10  (joint training, LR=3e-5, no freeze): best result was\n#     EPOCH 1 (macro-F1=0.6271), then degraded every epoch after\n#     (0.627 -> 0.591 -> 0.442 -> ...). The pretrained backbone was\n#     being pulled away from its Stage 09B optimum by noisy gradients\n#     from the randomly-initialized GRU/classifier.\n#   Stage 10B (frozen backbone for 6 epochs, then unfreeze at 5e-6):\n#     freezing backfired — the GRU had to learn temporal reasoning on\n#     top of features shaped for a different (softmax-only) decision\n#     boundary, and 6 epochs of that dragged the joint system into a\n#     worse optimum (best=0.5597) that gentle unfreezing couldn't\n#     escape. This performed worse than Stage 10's own flawed run.\n#\n# Conclusion: joint training from epoch 1 is the right regime — the\n# backbone SHOULD keep adapting alongside the GRU, just more slowly\n# than Stage 10's 3e-5 allowed. This run:\n#   1. Trains everything jointly from epoch 1 (no freeze phase)\n#   2. Uses a lower LR (1e-5 vs Stage 10's 3e-5) so the backbone\n#      drifts more slowly, aiming to stretch the \"good\" region from\n#      a single epoch into several, giving checkpointing a real\n#      chance to land on a stable point rather than a lucky epoch 1\n#   3. Uses aggressive early stopping (patience=2) since we now have\n#      direct evidence the useful signal appears early and decays —\n#      no reason to keep training 20+ epochs searching for a later\n#      peak that hasn't appeared in two prior attempts\n#   4. Reuses Stage 10B's frame cache (same cache files, same\n#      window construction) — no need to rebuild, keeps epoch time\n#      fast (~3 min/epoch based on 10B's post-cache timings)\n#\n# Uses the same Stage 05B locked split and Stage 07 pain_class\n# bins. Does not modify the split. Does not touch the test set.\n# ================================================================\nimport json, time\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom PIL import Image\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom torchvision import transforms, models\nfrom sklearn.metrics import (\n    accuracy_score,\n    balanced_accuracy_score,\n    f1_score,\n    confusion_matrix,\n)\n\nBASE = Path(\"/kaggle/working/capstone\")\nDATA = BASE / \"metadata\" / \"stage07\"\nSTAGE09B_CKPT = BASE / \"models\" / \"stage09b\" / \"best_resnet18_stage09b.pth\"\nOUT = BASE / \"models\" / \"stage10c\"\nCACHE_DIR = BASE / \"cache\" / \"stage10b_frames\"   # reuse Stage 10B's cache — same frames\nOUT.mkdir(parents=True, exist_ok=True)\nCACHE_DIR.mkdir(parents=True, exist_ok=True)\n\nprint(\"=\" * 65)\nprint(\"CAPSTONE — STAGE 10C\")\nprint(\"Joint Training, Low LR, Tight Early Stopping\")\nprint(\"=\" * 65)\n\n# ------------------------------------------------------------\n# Configuration\n# ------------------------------------------------------------\nSEED = 42\nIMG_SIZE = 224\nWINDOW_SIZE = 7\nWINDOW_HALF = WINDOW_SIZE // 2\nBATCH_SIZE = 48\nNUM_WORKERS = 4\nMAX_EPOCHS = 15              # no point going long given the observed decay pattern\nLR = 1e-5                    # lower than Stage 10's 3e-5 — slow the backbone drift\nGRU_HIDDEN = 128\nGRU_LAYERS = 1\nWEIGHT_DECAY = 1e-4\nNUM_CLASSES = 4\nDROPOUT_P = 0.4\nFOCAL_GAMMA = 2.0\nLABEL_SMOOTHING = 0.1\nEARLY_STOP_PATIENCE = 2       # tight — catch the early peak, don't chase a later one\nMOVING_AVG_WINDOW = 2         # shorter smoothing window to stay responsive to an early peak\nUSE_AMP = True\n\ntorch.manual_seed(SEED)\nnp.random.seed(SEED)\nif torch.cuda.is_available():\n    torch.cuda.manual_seed_all(SEED)\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"\\nDevice : {device}\")\nif torch.cuda.is_available():\n    print(f\"GPU    : {torch.cuda.get_device_name(0)}\")\n\nlabels_map = {0: \"No pain\", 1: \"Low pain\", 2: \"Moderate pain\", 3: \"High pain\"}\n\n# ------------------------------------------------------------\n# Load Stage 07 manifests (locked Stage 05B split — UNCHANGED)\n# ------------------------------------------------------------\ntrain = pd.read_csv(DATA / \"train_model.csv\")\nval = pd.read_csv(DATA / \"validation_model.csv\")\n\nprint(f\"\\nTrain frames      : {len(train):,}\")\nprint(f\"Validation frames : {len(val):,}\")\n\n# ------------------------------------------------------------\n# Frame cache — identical logic to Stage 10B. If Stage 10B already\n# ran in this session/persistent storage, this loads instantly\n# instead of rebuilding.\n# ------------------------------------------------------------\nresize_only = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n])\n\n\ndef build_frame_cache(df, cache_name):\n    cache_path = CACHE_DIR / f\"{cache_name}.pt\"\n    index_path = CACHE_DIR / f\"{cache_name}_index.json\"\n\n    if cache_path.exists() and index_path.exists():\n        print(f\"  Found existing cache for '{cache_name}', loading...\")\n        tensor = torch.load(cache_path, map_location=\"cpu\")\n        with open(index_path) as f:\n            frame_id_to_row = json.load(f)\n        if len(frame_id_to_row) == len(df) and tensor.shape[0] == len(df):\n            print(f\"  Cache OK: {tensor.shape[0]:,} frames\")\n            return tensor, frame_id_to_row\n        print(\"  Cache size mismatch with current manifest — rebuilding.\")\n\n    print(f\"  Building cache for '{cache_name}' ({len(df):,} frames)...\")\n    t0 = time.time()\n    frame_id_to_row = {}\n    tensor = torch.empty((len(df), 3, IMG_SIZE, IMG_SIZE), dtype=torch.float16)\n\n    for i, r in enumerate(df.itertuples(index=False)):\n        img = Image.open(r.image_path).convert(\"RGB\")\n        img = resize_only(img)\n        tensor[i] = img.half()\n        frame_id_to_row[str(r.frame_id)] = i\n        if (i + 1) % 5000 == 0:\n            elapsed = time.time() - t0\n            print(f\"    {i + 1:,}/{len(df):,} frames cached ({elapsed:.0f}s elapsed)\")\n\n    torch.save(tensor, cache_path)\n    with open(index_path, \"w\") as f:\n        json.dump(frame_id_to_row, f)\n\n    print(f\"  Cache built in {time.time() - t0:.0f}s, saved to {cache_path}\")\n    return tensor, frame_id_to_row\n\n\nprint(\"\\nLoading/building training frame cache...\")\ntrain_cache, train_frame_index = build_frame_cache(train, \"train\")\nprint(\"\\nLoading/building validation frame cache...\")\nval_cache, val_frame_index = build_frame_cache(val, \"validation\")\n\n# ------------------------------------------------------------\n# Window index\n# ------------------------------------------------------------\ndef build_window_index(df, frame_index):\n    df = df.sort_values([\"sequence_id\", \"frame_number\"]).reset_index(drop=True)\n    windows = []\n    for seq_id, group in df.groupby(\"sequence_id\"):\n        group = group.reset_index(drop=True)\n        frame_ids = group.frame_id.tolist()\n        labels = group.pain_class.tolist()\n        n = len(group)\n        for center_i in range(n):\n            idxs = []\n            for offset in range(-WINDOW_HALF, WINDOW_HALF + 1):\n                j = max(0, min(n - 1, center_i + offset))\n                idxs.append(frame_index[str(frame_ids[j])])\n            windows.append({\"row_idxs\": idxs, \"label\": int(labels[center_i])})\n    return windows\n\n\nprint(\"\\nBuilding frame windows...\")\ntrain_windows = build_window_index(train, train_frame_index)\nval_windows = build_window_index(val, val_frame_index)\nprint(f\"Train windows      : {len(train_windows):,}\")\nprint(f\"Validation windows : {len(val_windows):,}\")\n\n\nclass CachedWindowDataset(Dataset):\n    def __init__(self, windows, cache_tensor, train_mode):\n        self.windows = windows\n        self.cache = cache_tensor\n        self.train_mode = train_mode\n\n    def __len__(self):\n        return len(self.windows)\n\n    def __getitem__(self, i):\n        w = self.windows[i]\n        clip = self.cache[w[\"row_idxs\"]].float()\n        if self.train_mode and np.random.rand() < 0.5:\n            clip = torch.flip(clip, dims=[3])\n        y = torch.tensor(w[\"label\"], dtype=torch.long)\n        return clip, y\n\n\ntrain_ds = CachedWindowDataset(train_windows, train_cache, train_mode=True)\nval_ds = CachedWindowDataset(val_windows, val_cache, train_mode=False)\n\n# ------------------------------------------------------------\n# WeightedRandomSampler\n# ------------------------------------------------------------\ntrain_center_labels = np.array([w[\"label\"] for w in train_windows])\nclass_counts = pd.Series(train_center_labels).value_counts().sort_index()\nclass_sample_weights = {int(k): 1.0 / v for k, v in class_counts.items()}\nsample_weights = np.array([class_sample_weights[l] for l in train_center_labels])\nsampler = WeightedRandomSampler(\n    weights=sample_weights, num_samples=len(sample_weights), replacement=True,\n)\n\ntrain_loader = DataLoader(\n    train_ds, batch_size=BATCH_SIZE, sampler=sampler,\n    num_workers=NUM_WORKERS, pin_memory=True, persistent_workers=True,\n)\nval_loader = DataLoader(\n    val_ds, batch_size=BATCH_SIZE, shuffle=False,\n    num_workers=NUM_WORKERS, pin_memory=True, persistent_workers=True,\n)\n\nprint(\"\\nSampler class weights (1/frequency, computed on window centers):\")\nfor k, v in class_sample_weights.items():\n    print(f\"  {labels_map[k]:15s}: {v:.6f}\")\n\n# ------------------------------------------------------------\n# Model — identical architecture to Stage 10 / 10B\n# ------------------------------------------------------------\nclass CNNGRUPainModel(nn.Module):\n    def __init__(self, num_classes, gru_hidden=128, gru_layers=1, dropout_p=0.4):\n        super().__init__()\n        backbone = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)\n        feat_dim = backbone.fc.in_features\n        backbone.fc = nn.Identity()\n        self.backbone = backbone\n        self.feat_dim = feat_dim\n\n        self.gru = nn.GRU(\n            input_size=feat_dim, hidden_size=gru_hidden, num_layers=gru_layers,\n            batch_first=True, bidirectional=True,\n        )\n        self.dropout = nn.Dropout(p=dropout_p)\n        self.classifier = nn.Linear(gru_hidden * 2, num_classes)\n\n    def forward(self, clips):\n        B, T, C, H, W = clips.shape\n        flat = clips.view(B * T, C, H, W)\n        feats = self.backbone(flat)\n        feats = feats.view(B, T, self.feat_dim)\n        gru_out, _ = self.gru(feats)\n        center_repr = gru_out[:, T // 2, :]\n        center_repr = self.dropout(center_repr)\n        return self.classifier(center_repr)\n\n\nmodel = CNNGRUPainModel(\n    num_classes=NUM_CLASSES, gru_hidden=GRU_HIDDEN,\n    gru_layers=GRU_LAYERS, dropout_p=DROPOUT_P,\n).to(device)\n\nif STAGE09B_CKPT.exists():\n    print(f\"\\nWarm-starting backbone from Stage 09B checkpoint: {STAGE09B_CKPT}\")\n    ckpt09b = torch.load(STAGE09B_CKPT, map_location=device)\n    backbone_state = {\n        k: v for k, v in ckpt09b[\"model_state_dict\"].items() if not k.startswith(\"fc.\")\n    }\n    missing, unexpected = model.backbone.load_state_dict(backbone_state, strict=False)\n    print(f\"  Loaded backbone weights. Missing keys: {len(missing)}, \"\n          f\"unexpected: {len(unexpected)}\")\nelse:\n    print(f\"\\nWARNING: Stage 09B checkpoint not found. Using ImageNet-pretrained backbone.\")\n\n# All parameters trainable from epoch 1 — no freeze phase. Stage 10B\n# showed freezing hurts more than the joint-training drift it was\n# meant to prevent.\nfor p in model.parameters():\n    p.requires_grad = True\n\n# ------------------------------------------------------------\n# Focal loss — unchanged\n# ------------------------------------------------------------\ncounts = pd.Series(train_center_labels).value_counts().sort_index()\nalpha = torch.tensor(\n    [len(train_center_labels) / (NUM_CLASSES * counts.get(i, 0)) for i in range(NUM_CLASSES)],\n    dtype=torch.float32, device=device,\n)\nalpha = alpha / alpha.sum() * NUM_CLASSES\n\nprint(\"\\nFocal loss alpha (class weights):\")\nfor i, a in enumerate(alpha):\n    print(f\"  {labels_map[i]:15s}: {a.item():.4f}\")\n\n\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha, gamma=2.0, label_smoothing=0.0):\n        super().__init__()\n        self.alpha = alpha\n        self.gamma = gamma\n        self.label_smoothing = label_smoothing\n\n    def forward(self, logits, targets):\n        ce = F.cross_entropy(\n            logits, targets, reduction=\"none\", label_smoothing=self.label_smoothing,\n        )\n        pt = torch.exp(-ce)\n        at = self.alpha[targets]\n        return (at * (1 - pt) ** self.gamma * ce).mean()\n\n\ncriterion = FocalLoss(alpha=alpha, gamma=FOCAL_GAMMA, label_smoothing=LABEL_SMOOTHING)\n\noptimizer = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\nscaler = torch.amp.GradScaler(\"cuda\", enabled=USE_AMP)\n\n# No LR scheduler this run — given the pattern is early-peak-then-\n# decay rather than a plateau, a scheduler reacting to val_macro_f1\n# would only start cutting LR after the peak has already passed.\n# A single low, fixed LR is simpler and matches what we're testing.\n\n# ------------------------------------------------------------\n# Training loop\n# ------------------------------------------------------------\nhistory = []\nval_f1_raw_history = []\nbest_f1_smoothed = -1\nbest_epoch = -1\nepochs_without_improvement = 0\n\nfor epoch in range(1, MAX_EPOCHS + 1):\n    start = time.time()\n    model.train()\n\n    train_loss = 0\n    train_true, train_pred = [], []\n\n    for clips, lbls in train_loader:\n        clips = clips.to(device, non_blocking=True)\n        lbls = lbls.to(device, non_blocking=True)\n\n        optimizer.zero_grad(set_to_none=True)\n        with torch.amp.autocast(\"cuda\", enabled=USE_AMP):\n            logits = model(clips)\n            loss = criterion(logits, lbls)\n\n        scaler.scale(loss).backward()\n        scaler.step(optimizer)\n        scaler.update()\n\n        train_loss += loss.item() * clips.size(0)\n        train_true.extend(lbls.detach().cpu().numpy())\n        train_pred.extend(logits.argmax(1).detach().cpu().numpy())\n\n    train_loss /= len(train_ds)\n    train_acc = accuracy_score(train_true, train_pred)\n    train_f1 = f1_score(train_true, train_pred, average=\"macro\", zero_division=0)\n\n    model.eval()\n    val_loss = 0\n    val_true, val_pred = [], []\n\n    with torch.no_grad():\n        for clips, lbls in val_loader:\n            clips = clips.to(device, non_blocking=True)\n            lbls = lbls.to(device, non_blocking=True)\n            with torch.amp.autocast(\"cuda\", enabled=USE_AMP):\n                logits = model(clips)\n                loss = criterion(logits, lbls)\n            val_loss += loss.item() * clips.size(0)\n            val_true.extend(lbls.cpu().numpy())\n            val_pred.extend(logits.argmax(1).cpu().numpy())\n\n    val_loss /= len(val_ds)\n    val_acc = accuracy_score(val_true, val_pred)\n    val_bal_acc = balanced_accuracy_score(val_true, val_pred)\n    val_f1 = f1_score(val_true, val_pred, average=\"macro\", zero_division=0)\n    val_f1_per_class = f1_score(\n        val_true, val_pred, average=None, zero_division=0, labels=list(range(NUM_CLASSES))\n    )\n    cm = confusion_matrix(val_true, val_pred, labels=list(range(NUM_CLASSES)))\n\n    val_f1_raw_history.append(val_f1)\n    val_f1_smoothed = float(np.mean(val_f1_raw_history[-MOVING_AVG_WINDOW:]))\n\n    elapsed = time.time() - start\n\n    row = {\n        \"epoch\": epoch,\n        \"train_loss\": train_loss, \"train_accuracy\": train_acc, \"train_macro_f1\": train_f1,\n        \"val_loss\": val_loss, \"val_accuracy\": val_acc, \"val_balanced_accuracy\": val_bal_acc,\n        \"val_macro_f1\": val_f1, \"val_macro_f1_smoothed\": val_f1_smoothed,\n        \"lr\": optimizer.param_groups[0][\"lr\"], \"time_sec\": elapsed,\n    }\n    for i in range(NUM_CLASSES):\n        row[f\"val_f1_class_{i}_{labels_map[i].replace(' ', '_')}\"] = val_f1_per_class[i]\n    history.append(row)\n\n    print(\n        f\"Epoch {epoch:02d}/{MAX_EPOCHS} | \"\n        f\"Train Loss {train_loss:.4f} | Val Loss {val_loss:.4f} | \"\n        f\"Val Acc {val_acc:.4f} | Val Bal Acc {val_bal_acc:.4f} | \"\n        f\"Val Macro-F1 {val_f1:.4f} (smoothed {val_f1_smoothed:.4f}) | {elapsed:.1f}s\"\n    )\n    print(f\"  Per-class F1: \" + \", \".join(\n        f\"{labels_map[i]}={val_f1_per_class[i]:.3f}\" for i in range(NUM_CLASSES)\n    ))\n    print(f\"  Confusion matrix (rows=true, cols=pred):\\n{cm}\")\n\n    if val_f1_smoothed > best_f1_smoothed:\n        best_f1_smoothed = val_f1_smoothed\n        best_epoch = epoch\n        epochs_without_improvement = 0\n\n        torch.save({\n            \"stage\": \"10c\", \"epoch\": epoch, \"model_state_dict\": model.state_dict(),\n            \"optimizer_state_dict\": optimizer.state_dict(),\n            \"best_val_macro_f1_raw\": val_f1, \"best_val_macro_f1_smoothed\": best_f1_smoothed,\n            \"window_size\": WINDOW_SIZE, \"gru_hidden\": GRU_HIDDEN, \"gru_layers\": GRU_LAYERS,\n            \"seed\": SEED, \"img_size\": IMG_SIZE, \"num_classes\": NUM_CLASSES,\n            \"confusion_matrix\": cm.tolist(),\n        }, OUT / \"best_cnn_gru_stage10c.pth\")\n\n        print(f\"  ✓ Best checkpoint saved (smoothed Macro-F1={best_f1_smoothed:.4f}, \"\n              f\"r