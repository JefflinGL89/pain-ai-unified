k":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mKeyboardInterrupt\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_59/3069204065.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m    342\u001b[0m         \u001b[0moptimizer\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mstep\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    343\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 344\u001b[0;31m         \u001b[0mtrain_loss\u001b[0m \u001b[0;34m+=\u001b[0m \u001b[0mloss\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mitem\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;34m*\u001b[0m \u001b[0mclips\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0msize\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;36m0\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    345\u001b[0m         \u001b[0mtrain_true\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mextend\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mlbls\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mdetach\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mcpu\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mnumpy\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    346\u001b[0m         \u001b[0mtrain_pred\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mextend\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mlogits\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0margmax\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;36m1\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mdetach\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mcpu\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mnumpy\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mKeyboardInterrupt\u001b[0m: "],"ename":"KeyboardInterrupt","evalue":"","output_type":"error"}],"execution_count":1},{"cell_type":"code","source":"# ================================================================\n# CAPSTONE — STAGE 10B | FIXED + FASTER TEMPORAL SEQUENCE MODEL\n#\n# Fixes applied vs Stage 10:\n#   1. CORRUPTION FIX: Stage 10 warm-started the backbone from a\n#      converged Stage 09B checkpoint, then trained backbone+GRU+\n#      classifier together from epoch 1. The GRU/classifier were\n#      randomly initialized, so their noisy early gradients flowed\n#      straight back into the good pretrained backbone and degraded\n#      it every epoch (0.627 -> 0.591 -> 0.442 -> ...). Fix: freeze\n#      the backbone for the first FREEZE_EPOCHS, let only the GRU +\n#      classifier converge, THEN unfreeze for gentle joint fine-tuning\n#      at a much lower LR.\n#\n#   2. SPEED FIX (Stage 10 was ~18-19 min/epoch): the dominant cost\n#      was re-decoding+resizing every frame from disk with PIL,\n#      7 times per window, every epoch, because overlapping windows\n#      (frame N is the center of one window and a neighbor in six\n#      others) were never cached or precomputed.\n#        a. Precompute a single resized+normalized tensor per unique\n#           frame ONCE up front (cached in a memory-mapped .pt file),\n#           so each frame is decoded from disk exactly once total,\n#           not ~7 times per epoch.\n#        b. Windows are then built by indexing into that cache\n#           (near-zero cost), instead of re-reading images.\n#        c. AMP (mixed precision) + larger batch size, since the\n#           heavy CNN forward pass is now the only real GPU cost.\n#        d. num_workers raised and persistent_workers enabled.\n#      Expected effect: most of the per-epoch cost moves to a\n#      ONE-TIME upfront caching step; subsequent epoch time should\n#      drop to a small fraction of Stage 10's 18 min.\n#\n# Uses the same Stage 05B locked split and Stage 07 pain_class\n# bins. Does not modify the split. Does not touch the test set.\n# ================================================================\nimport json, time\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom PIL import Image\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom torchvision import transforms, models\nfrom sklearn.metrics import (\n    accuracy_score,\n    balanced_accuracy_score,\n    f1_score,\n    confusion_matrix,\n)\n\nBASE = Path(\"/kaggle/working/capstone\")\nDATA = BASE / \"metadata\" / \"stage07\"\nSTAGE09B_CKPT = BASE / \"models\" / \"stage09b\" / \"best_resnet18_stage09b.pth\"\nOUT = BASE / \"models\" / \"stage10b\"\nCACHE_DIR = BASE / \"cache\" / \"stage10b_frames\"\nOUT.mkdir(parents=True, exist_ok=True)\nCACHE_DIR.mkdir(parents=True, exist_ok=True)\n\nprint(\"=\" * 65)\nprint(\"CAPSTONE — STAGE 10B\")\nprint(\"Fixed + Faster Temporal Sequence Model (CNN + GRU)\")\nprint(\"=\" * 65)\n\n# ------------------------------------------------------------\n# Configuration\n# ------------------------------------------------------------\nSEED = 42\nIMG_SIZE = 224\nWINDOW_SIZE = 7\nWINDOW_HALF = WINDOW_SIZE // 2\nBATCH_SIZE = 48              # can go higher now that frame decode isn't the bottleneck\nNUM_WORKERS = 4\nMAX_EPOCHS = 30\nFREEZE_EPOCHS = 6            # backbone frozen while GRU+classifier converge\nLR_HEAD = 1e-4                # LR for GRU+classifier during freeze phase\nLR_FINETUNE = 5e-6            # LR once backbone unfreezes — deliberately low,\n                               # since it's already converged from Stage 09B\nGRU_HIDDEN = 128\nGRU_LAYERS = 1\nWEIGHT_DECAY = 1e-4\nNUM_CLASSES = 4\nDROPOUT_P = 0.4\nFOCAL_GAMMA = 2.0\nLABEL_SMOOTHING = 0.1\nEARLY_STOP_PATIENCE = 7\nPLATEAU_PATIENCE = 3\nPLATEAU_FACTOR = 0.5\nMOVING_AVG_WINDOW = 3\nUSE_AMP = True\n\ntorch.manual_seed(SEED)\nnp.random.seed(SEED)\nif torch.cuda.is_available():\n    torch.cuda.manual_seed_all(SEED)\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"\\nDevice : {device}\")\nif torch.cuda.is_available():\n    print(f\"GPU    : {torch.cuda.get_device_name(0)}\")\n\nlabels_map = {0: \"No pain\", 1: \"Low pain\", 2: \"Moderate pain\", 3: \"High pain\"}\n\n# ------------------------------------------------------------\n# Load Stage 07 manifests (locked Stage 05B split — UNCHANGED)\n# ------------------------------------------------------------\ntrain = pd.read_csv(DATA / \"train_model.csv\")\nval = pd.read_csv(DATA / \"validation_model.csv\")\n\nprint(f\"\\nTrain frames      : {len(train):,}\")\nprint(f\"Validation frames : {len(val):,}\")\n\n# ------------------------------------------------------------\n# STEP 1 — Precompute and cache every unique frame ONCE.\n# This is the main speed fix: Stage 10 decoded+resized each frame\n# from disk ~7x per epoch (once per window it appeared in) because\n# windows overlap heavily. Here every frame is processed exactly\n# once, ever, and stored as a normalized float16 tensor on disk in\n# a single memory-mapped file per split. Loading a cached frame at\n# train time is then a pure tensor index, not a JPEG decode.\n# ------------------------------------------------------------\nresize_only = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n])\n\n\ndef build_frame_cache(df, cache_name):\n    \"\"\"Returns (cache_tensor, frame_id_to_row) where cache_tensor is\n    a (N, 3, H, W) float16 tensor on disk (memory-mapped via torch.load\n    with mmap where supported), and frame_id_to_row maps frame_id -> row\n    index into that tensor.\"\"\"\n    cache_path = CACHE_DIR / f\"{cache_name}.pt\"\n    index_path = CACHE_DIR / f\"{cache_name}_index.json\"\n\n    if cache_path.exists() and index_path.exists():\n        print(f\"  Found existing cache for '{cache_name}', loading...\")\n        tensor = torch.load(cache_path, map_location=\"cpu\")\n        with open(index_path) as f:\n            frame_id_to_row = json.load(f)\n        if len(frame_id_to_row) == len(df) and tensor.shape[0] == len(df):\n            print(f\"  Cache OK: {tensor.shape[0]:,} frames\")\n            return tensor, frame_id_to_row\n        print(\"  Cache size mismatch with current manifest — rebuilding.\")\n\n    print(f\"  Building cache for '{cache_name}' ({len(df):,} frames)... \"\n          f\"this runs once and is reused on future runs.\")\n    t0 = time.time()\n    frame_id_to_row = {}\n    tensor = torch.empty((len(df), 3, IMG_SIZE, IMG_SIZE), dtype=torch.float16)\n\n    for i, r in enumerate(df.itertuples(index=False)):\n        img = Image.open(r.image_path).convert(\"RGB\")\n        img = resize_only(img)\n        tensor[i] = img.half()\n        frame_id_to_row[str(r.frame_id)] = i\n        if (i + 1) % 5000 == 0:\n            elapsed = time.time() - t0\n            print(f\"    {i + 1:,}/{len(df):,} frames cached ({elapsed:.0f}s elapsed)\")\n\n    torch.save(tensor, cache_path)\n    with open(index_path, \"w\") as f:\n        json.dump(frame_id_to_row, f)\n\n    print(f\"  Cache built in {time.time() - t0:.0f}s, saved to {cache_path}\")\n    return tensor, frame_id_to_row\n\n\nprint(\"\\nCaching training frames...\")\ntrain_cache, train_frame_index = build_frame_cache(train, \"train\")\nprint(\"\\nCaching validation frames...\")\nval_cache, val_frame_index = build_frame_cache(val, \"validation\")\n\n# ------------------------------------------------------------\n# STEP 2 — Build window index (frame_id references, not paths)\n# ------------------------------------------------------------\ndef build_window_index(df, frame_index):\n    df = df.sort_values([\"sequence_id\", \"frame_number\"]).reset_index(drop=True)\n    windows = []\n    for seq_id, group in df.groupby(\"sequence_id\"):\n        group = group.reset_index(drop=True)\n        frame_ids = group.frame_id.tolist()\n        labels = group.pain_class.tolist()\n        n = len(group)\n        for center_i in range(n):\n            idxs = []\n            for offset in range(-WINDOW_HALF, WINDOW_HALF + 1):\n                j = max(0, min(n - 1, center_i + offset))\n                idxs.append(frame_index[str(frame_ids[j])])\n            windows.append({\n                \"row_idxs\": idxs,           # indices into the cache tensor\n                \"label\": int(labels[center_i]),\n            })\n    return windows\n\n\nprint(\"\\nBuilding frame windows (indexing into cache, near-instant)...\")\ntrain_windows = build_window_index(train, train_frame_index)\nval_windows = build_window_index(val, val_frame_index)\nprint(f\"Train windows      : {len(train_windows):,}\")\nprint(f\"Validation windows : {len(val_windows):,}\")\n\n# ------------------------------------------------------------\n# Dataset — reads from the in-memory cache tensor, no disk I/O\n# per __getitem__ beyond a tensor index. Light augmentation\n# (horizontal flip only, applied consistently across the window)\n# happens here since it's just a tensor flip, essentially free.\n# ------------------------------------------------------------\nclass CachedWindowDataset(Dataset):\n    def __init__(self, windows, cache_tensor, train_mode):\n        self.windows = windows\n        self.cache = cache_tensor\n        self.train_mode = train_mode\n\n    def __len__(self):\n        return len(self.windows)\n\n    def __getitem__(self, i):\n        w = self.windows[i]\n        clip = self.cache[w[\"row_idxs\"]].float()   # (T, C, H, W), cast back to fp32\n        if self.train_mode and np.random.rand() < 0.5:\n            clip = torch.flip(clip, dims=[3])       # horizontal flip, whole window\n        y = torch.tensor(w[\"label\"], dtype=torch.long)\n        return clip, y\n\n\ntrain_ds = CachedWindowDataset(train_windows, train_cache, train_mode=True)\nval_ds = CachedWindowDataset(val_windows, val_cache, train_mode=False)\n\n# ------------------------------------------------------------\n# WeightedRandomSampler\n# ------------------------------------------------------------\ntrain_center_labels = np.array([w[\"label\"] for w in train_windows])\nclass_counts = pd.Series(train_center_labels).value_counts().sort_index()\nclass_sample_weights = {int(k): 1.0 / v for k, v in class_counts.items()}\nsample_weights = np.array([class_sample_weights[l] for l in train_center_labels])\nsampler = WeightedRandomSampler(\n    weights=sample_weights, num_samples=len(sample_weights), replacement=True,\n)\n\ntrain_loader = DataLoader(\n    train_ds, batch_size=BATCH_SIZE, sampler=sampler,\n    num_workers=NUM_WORKERS, pin_memory=True, persistent_workers=True,\n)\nval_loader = DataLoader(\n    val_ds, batch_size=BATCH_SIZE, shuffle=False,\n    num_workers=NUM_WORKERS, pin_memory=True, persistent_workers=True,\n)\n\nprint(\"\\nSampler class weights (1/frequency, computed on window centers):\")\nfor k, v in class_sample_weights.items():\n    print(f\"  {labels_map[k]:15s}: {v:.6f}\")\n\n# ------------------------------------------------------------\n# Model — identical architecture to Stage 10\n# ------------------------------------------------------------\nclass CNNGRUPainModel(nn.Module):\n    def __init__(self, num_classes, gru_hidden=128, gru_layers=1, dropout_p=0.4):\n        super().__init__()\n        backbone = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)\n        feat_dim = backbone.fc.in_features\n        backbone.fc = nn.Identity()\n        self.backbone = backbone\n        self.feat_dim = feat_dim\n\n        self.gru = nn.GRU(\n            input_size=feat_dim, hidden_size=gru_hidden, num_layers=gru_layers,\n            batch_first=True, bidirectional=True,\n        )\n        self.dropout = nn.Dropout(p=dropout_p)\n        self.classifier = nn.Linear(gru_hidden * 2, num_classes)\n\n    def forward(self, clips):\n        B, T, C, H, W = clips.shape\n        flat = clips.view(B * T, C, H, W)\n        feats = self.backbone(flat)\n        feats = feats.view(B, T, self.feat_dim)\n        gru_out, _ = self.gru(feats)\n        center_repr = gru_out[:, T // 2, :]\n        center_repr = self.dropout(center_repr)\n        return self.classifier(center_repr)\n\n\nmodel = CNNGRUPainModel(\n    num_classes=NUM_CLASSES, gru_hidden=GRU_HIDDEN,\n    gru_layers=GRU_LAYERS, dropout_p=DROPOUT_P,\n).to(device)\n\nif STAGE09B_CKPT.exists():\n    print(f\"\\nWarm-starting backbone from Stage 09B checkpoint: {STAGE09B_CKPT}\")\n    ckpt09b = torch.load(STAGE09B_CKPT, map_location=device)\n    backbone_state = {\n        k: v for k, v in ckpt09b[\"model_state_dict\"].items() if not k.startswith(\"fc.\")\n    }\n    missing, unexpected = model.backbone.load_state_dict(backbone_state, strict=False)\n    print(f\"  Loaded backbone weights. Missing keys: {len(missing)}, \"\n          f\"unexpected: {len(unexpected)}\")\nelse:\n    print(f\"\\nWARNING: Stage 09B checkpoint not found. Using ImageNet-pretrained backbone.\")\n\n\ndef set_backbone_trainable(model, trainable: bool):\n    for p in model.backbone.parameters():\n        p.requires_grad = trainable\n\n\n# Freeze backbone at the start — this is the corruption fix. The\n# GRU and classifier are randomly initialized and need to converge\n# on their own before their gradients are allowed to touch the\n# already-good pretrained backbone.\nset_backbone_trainable(model, trainable=False)\nprint(f\"\\nBackbone FROZEN for the first {FREEZE_EPOCHS} epochs \"\n      f\"(GRU + classifier train alone at LR={LR_HEAD})\")\n\n# ------------------------------------------------------------\n# Focal loss — same as Stage 10 (best-performing loss from 09B)\n# ------------------------------------------------------------\ncounts = pd.Series(train_center_labels).value_counts().sort_index()\nalpha = torch.tensor(\n    [len(train_center_labels) / (NUM_CLASSES * counts.get(i, 0)) for i in range(NUM_CLASSES)],\n    dtype=torch.float32, device=device,\n)\nalpha = alpha / alpha.sum() * NUM_CLASSES\n\nprint(\"\\nFocal loss alpha (class weights):\")\nfor i, a in enumerate(alpha):\n    print(f\"  {labels_map[i]:15s}: {a.item():.4f}\")\n\n\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha, gamma=2.0, label_smoothing=0.0):\n        super().__init__()\n        self.alpha = alpha\n        self.gamma = gamma\n        self.label_smoothing = label_smoothing\n\n    def forward(self, logits, targets):\n        ce = F.cross_entropy(\n            logits, targets, reduction=\"none\", label_smoothing=self.label_smoothing,\n        )\n        pt = torch.exp(-ce)\n        at = self.alpha[targets]\n        return (at * (1 - pt) ** self.gamma * ce).mean()\n\n\ncriterion = FocalLoss(alpha=alpha, gamma=FOCAL_GAMMA, label_smoothing=LABEL_SMOOTHING)\n\n\ndef build_optimizer(model, lr):\n    trainable = [p for p in model.parameters() if p.requires_grad]\n    return torch.optim.AdamW(trainable, lr=lr, weight_decay=WEIGHT_DECAY)\n\n\noptimizer = build_optimizer(model, LR_HEAD)\nscheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n    optimizer, mode=\"max\", factor=PLATEAU_FACTOR, patience=PLATEAU_PATIENCE,\n)\nscaler = torch.cuda.amp.GradScaler(enabled=USE_AMP)\n\n# ------------------------------------------------------------\n# Training loop with progressive unfreezing\n# ------------------------------------------------------------\nhistory = []\nval_f1_raw_history = []\nbest_f1_smoothed = -1\nbest_epoch = -1\nepochs_without_improvement = 0\nunfrozen = False\n\nfor epoch in range(1, MAX_EPOCHS + 1):\n\n    if epoch == FREEZE_EPOCHS + 1 and not unfrozen:\n        print(f\"\\n>>> Unfreezing backbone at epoch {epoch} (LR -> {LR_FINETUNE})\")\n        set_backbone_trainable(model, trainable=True)\n        optimizer = b